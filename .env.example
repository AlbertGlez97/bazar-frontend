# URL base del backend — copiar a .env
VITE_API_URL=http://localhost:3000/api/v1

# Clave PÚBLICA de Cloudflare Turnstile (site key) para el registro de negocios.
# Para desarrollo local usa las claves de prueba de Cloudflare:
#   1x00000000000000000000AA (siempre pasa) | 2x00000000000000000000AB (siempre falla)
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
VITE_TURNSTILE_SITE_KEY=
